{
  "name": "cueforge-desktop",
  "version": "0.1.0",
  "description": "Open source performance soundboard for Windows",
  "author": "CueForge contributors",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "setup:audio": "node scripts/setup-audio.mjs",
    "format": "prettier --write src electron scripts tests *.json *.ts *.md docs",
    "format:check": "prettier --check src electron scripts tests *.json *.ts *.md docs",
    "test:formats": "node scripts/formats.mjs",
    "demo": "node scripts/demo.mjs",
    "test:controls": "node scripts/controls.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.3.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.58.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "org.cueforge.desktop",
    "productName": "CueForge",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "CueForge-${version}-Windows-x64.exe"
    },
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "bin/ffmpeg.exe",
          "LICENSE",
          "README.txt"
        ]
      }
    ]
  },
  "type": "module"
}
